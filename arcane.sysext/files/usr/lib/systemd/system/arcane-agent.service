[Unit]
Description=Arcane Docker management agent
Documentation=https://getarcane.app
Wants=network-online.target docker.service
After=network-online.target docker.service
ConditionFileNotEmpty=/etc/arcane.d/arcane-agent.env

[Service]
EnvironmentFile=/etc/arcane.d/arcane-agent.env
Environment=AGENT_MODE=true
Environment=PROJECTS_DIRECTORY=/var/lib/arcane-agent/data/projects
Environment=TEMPLATES_DIRECTORY=/var/lib/arcane-agent/data/templates
Environment=DATABASE_URL=file:/var/lib/arcane-agent/data/arcane.db?_pragma=journal_mode(WAL)&_pragma=busy_timeout(2500)&_txlock=immediate
ExecStart=/usr/bin/arcane-agent
Restart=always
RestartSec=5
StateDirectory=arcane-agent

[Install]
WantedBy=multi-user.target
